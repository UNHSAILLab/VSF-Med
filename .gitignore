**/.claude/settings.local.json

# IDE / editor noise
.idea/
.vscode/
.DS_Store

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---------- PhysioNet-credentialed data — NEVER commit ----------
# MIMIC-CXR images (any format), MIMIC-Diff-VQA splits, derived cohorts.
# These must stay on disk only. .gitignore comments must be on their own lines —
# inline # is treated as part of the pattern by git.
data/
clinician_returns/

# Defense-in-depth: never commit any image format from this repo
*.jpg
*.jpeg
*.png
*.dcm
*.dicom
*.tif
*.tiff
*.bmp
*.webp
!docs/**/*.png

# Logs
*.log
nohup.out

# ---------- Secrets ----------
.env
.env.*
*.env
secrets/
**/credentials.json

# ---------- Clinician annotation bundle (contains MIMIC images) ----------
annotation_bundle/
VSF-Med-Annotation-Bundle-*.zip

# ---------- HuggingFace dataset build artifact ----------
hf_dataset/
